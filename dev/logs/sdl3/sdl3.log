= SDL3

https://wiki.libsdl.org/SDL3/README-linux#build-dependencies

----
libxcb-xinput-dev

sudo apt install libxcb-xinput-dev
sudo apt install evtest

libsdl3-dev

sudo apt install libsdl3-dev
sudo apt install xinput
sudo apt install imagemagick
